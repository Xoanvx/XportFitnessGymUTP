	<field name="activo" class="java.lang.Boolean"/>
	<variable name="TOTAL_ACTIVOS" calculation="Sum" class="java.lang.Integer">
		<expression><![CDATA[$F{activo} ? 1 : 0]]></expression>
	</variable>
