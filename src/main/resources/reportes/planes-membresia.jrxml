<!-- Reporte de planes de membresía. Formato JasperReports 7.0.8 (editable en Jaspersoft Studio 7). -->
<!-- Los datos los entrega ReportePlanesMembresiaServlet desde MembresiaFACADE (sp_ListaMembresia). -->
<jasperReport name="PlanesMembresia" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection" uuid="4f1d2c7a-8b3e-4a51-9c62-1d7e0f3a5b01">
	<parameter name="EMPRESA" class="java.lang.String"/>
	<parameter name="FILTRO" class="java.lang.String"/>
	<parameter name="USUARIO" class="java.lang.String"/>
	<parameter name="FECHA" class="java.lang.String"/>
	<field name="codigo" class="java.lang.String"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="duracion" class="java.lang.String"/>
	<field name="dias" class="java.lang.Integer"/>
