				<expression><![CDATA[$F{estado} == null ? "" : $F{estado}.trim().toUpperCase()]]></expression>
				<printWhenExpression><![CDATA[$F{activo}]]></printWhenExpression>
			</element>
			<element kind="textField" uuid="4f1d2c7a-8b3e-4a51-9c62-1d7e0f3a5b39" x="507" y="0" width="48" height="20" forecolor="#DC2626" fontSize="7.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
				<expression><![CDATA[$F{estado} == null ? "" : $F{estado}.trim().toUpperCase()]]></expression>
				<printWhenExpression><![CDATA[!$F{activo}]]></printWhenExpression>
