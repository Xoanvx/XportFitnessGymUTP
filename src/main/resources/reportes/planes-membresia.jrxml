				<expression><![CDATA[$F{limite} == null || $F{limite} == 0 ? "Sin límite" : String.valueOf($F{limite})]]></expression>
			</element>
			<element kind="textField" uuid="4f1d2c7a-8b3e-4a51-9c62-1d7e0f3a5b36" x="377" y="0" width="65" height="20" forecolor="#102653" fontSize="8.0" bold="true" hTextAlign="Right" vTextAlign="Middle" pattern="#,##0.00">
				<expression><![CDATA[$F{tarifa}]]></expression>
