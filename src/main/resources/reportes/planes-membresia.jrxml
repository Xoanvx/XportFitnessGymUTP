			<expression><![CDATA[$P{USUARIO} == null ? "" : "Usuario: " + $P{USUARIO}]]></expression>
		</element>
		<element kind="textField" uuid="4f1d2c7a-8b3e-4a51-9c62-1d7e0f3a5b15" x="0" y="60" width="555" height="16" forecolor="#64748B" fontSize="8.0" italic="true" vTextAlign="Middle">
			<expression><![CDATA[$P{FILTRO} == null || $P{FILTRO}.trim().isEmpty() ? "Todos los planes registrados" : "Filtro aplicado: \"" + $P{FILTRO}.trim() + "\""]]></expression>
		</element>
	</title>
