		<element kind="textField" uuid="4f1d2c7a-8b3e-4a51-9c62-1d7e0f3a5b11" x="14" y="6" width="380" height="16" forecolor="#BFD0F5" fontSize="9.0" bold="true" vTextAlign="Middle">
			<expression><![CDATA[$P{EMPRESA} == null ? "XPORT FITNESS GYM" : $P{EMPRESA}.toUpperCase()]]></expression>
		</element>
		<element kind="staticText" uuid="4f1d2c7a-8b3e-4a51-9c62-1d7e0f3a5b12" x="14" y="22" width="380" height="28" forecolor="#FFFFFF" fontSize="18.0" bold="true" vTextAlign="Middle">
			<text><![CDATA[Planes de Membresía]]></text>
		</element>
		<element kind="textField" uuid="4f1d2c7a-8b3e-4a51-9c62-1d7e0f3a5b13" x="394" y="6" width="150" height="22" forecolor="#FFFFFF" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA["Emitido: " + $P{FECHA}]]></expression>
		</element>
