		<element kind="textField" uuid="4f1d2c7a-8b3e-4a51-9c62-1d7e0f3a5b51" x="10" y="10" width="535" height="24" forecolor="#102653" fontSize="9.0" bold="true" vTextAlign="Middle">
			<expression><![CDATA["Total de planes: " + $V{REPORT_COUNT} + "     ·     Activos: " + $V{TOTAL_ACTIVOS} + "     ·     Inactivos: " + ($V{REPORT_COUNT} - $V{TOTAL_ACTIVOS})]]></expression>
